# Copy to .env and fill in. .env is git-ignored and must stay that way.

# Notion integration token. Create one at https://www.notion.so/my-integrations
# and share the target database with it, otherwise every write returns 404.
NOTION_TOKEN=

# The 32-character ID of the CRM database, taken from its URL.
NOTION_DATABASE_ID=

# Primary LLM provider, used first in the extraction cascade.
BAZAARLINK_API_KEY=

# Second provider, tried when the primary fails or is rate limited.
GROQ_API_KEY=

# Third and last provider in the cascade. If this one fails, the run yields no leads.
HUGGINGFACE_API_KEY=
